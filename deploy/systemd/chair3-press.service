[Unit]
Description=$CHAIR press-conference server on 127.0.0.1:18791 (answers from the reviewed book, line picked by the local model)
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=%h/Desktop/Projects/Survival/chair-worktrees/runtime/chair-agent/scripts/run-press.sh
Environment=PATH=%h/.local/share/mise/installs/node/26/bin:%h/.local/share/mise/installs/gh/latest/gh_2.103.3_linux_amd64/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# The overreach panel signs with the chair account's own function-call key (the only key it has; no second key can be added, the account holds no full-access key). Remove this line to switch the feature off.
Environment=CHAIR_OVERREACH_KEY_FILE=%h/.claude/secrets/survival-testnet/chair3/challenger.chair-coin-3.testnet.key
# The chain this desk reads and the account that signs the overreach test, named here as well as in run-press.sh so the unit says what it serves.
Environment=CHAIR_TOKEN=token.chair-coin-3.testnet
Environment=CHAIR_ACCOUNT=challenger.chair-coin-3.testnet
Environment=CHAIR_PRESS_PORT=18791
# press.jsonl of this token only (the old token's is in ~/.local/state/chair-agent); chair3-agent reads the same file.
Environment=CHAIR_STATE_DIR=%h/.local/state/chair3-agent
# The Join the Committee panel: the visitor pool account and its full-access key (a stake needs an attached deposit). Remove both lines to switch the feature off.
Environment=CHAIR_VISITOR_ACCOUNT=visitors.chair-coin-3.testnet
Environment=CHAIR_VISITOR_KEY_FILE=%h/.claude/secrets/survival-testnet/chair3/visitors.chair-coin-3.testnet.key
# The test-coin faucet (POST /faucet: 0.05 NEAR + 50 CHAIR per address, 200 grants in all). Its own account and key hold only its budget; no other account may be this one. Remove the key line to switch the faucet off; `touch` the kill file to stop it at once (rm to resume).
Environment=CHAIR_FAUCET_KEY_FILE=%h/.claude/secrets/survival-testnet/chair3/chair-faucet-3.testnet.key
Environment=CHAIR_FAUCET_ACCOUNT=chair-faucet-3.testnet
# The grants ledger: keep this path stable. If it goes missing after the faucet has run, the faucet stays off (see "Test-coin faucet" in chair-agent/README.md) instead of starting a new budget.
Environment=CHAIR_FAUCET_STATE_FILE=%h/.local/state/chair3-agent/faucet.json
Environment=CHAIR_FAUCET_KILL_FILE=%h/.local/state/chair3-agent/faucet.kill
# The agent tries these in order: a read that fails (429, down) moves to the next, a send only when the node refused it before taking it.
Environment=CHAIR_RPC_URL=https://rpc.testnet.fastnear.com,https://near-testnet.drpc.org,https://rpc.testnet.near.org
# The faucet asks these (archival: they keep every transaction, the ones above forget after about 31 hours) whether an old unfinished step ever landed; if none answers the step waits and is never paid again.
Environment=CHAIR_ARCHIVAL_RPC_URL=https://archival-rpc.testnet.fastnear.com
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
